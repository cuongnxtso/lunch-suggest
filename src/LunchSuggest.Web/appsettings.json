{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Lunch": {
    // The lunch group's first values, used when it's created. After that, change them on the Settings page
    // (http://localhost:8690/settings in Docker, /settings from this computer in dev); editing this file won't override them.
    "Code": "default",
    "Title": "Sport Hotel lunch",
    "Address": "Khách sạn Thể Thao (Sport Hotel), 15 Lê Văn Thiêm, Thanh Xuân, Hà Nội",
    "Lat": 21.0014221,
    "Lng": 105.8029205,
    "RadiusMeters": 300,
    "TimeZone": "Asia/Ho_Chi_Minh",
    // Local time the daily poll closes; after this the page shows the winner.
    "Deadline": "11:30",
    // Display: top bar / browser tab title, and the landing button emoji ("" = a different food icon every day).
    "SiteTitle": "",
    "LandingIcon": "",
    // Address in the invite link, e.g. "http://10.3.0.54:8686" ("" = the viewer's own address).
    "ShareUrl": "",
    // Poll: most options per poll (2–20), dishes the app adds to a new poll (0–8), runner-up look-back days (0 = off).
    "MaxOptions": 8,
    "PicksMin": 3,
    "PicksMax": 5,
    "RunnerUpDays": 5
  },
  // Google sign-in (see README, "Sign-in"). Empty ClientId = off: anyone with the link votes under a random name.
  // On: everyone can view; only people approved on the Settings page can vote. Keep the secret out of this file (use .env).
  "Google": {
    "ClientId": "",
    "ClientSecret": "",
    // Allowed to vote on their first sign-in, without waiting on the Settings page. Matched on the Google display name,
    // ignoring accents, case and word order ("Dao Dinh Luyen" and "Luyện Đào Đình" both match). Anyone else waits for approval.
    "AutoApprove": [
      "Đào Đình Luyện",
      "Nguyễn Huỳnh Đức",
      "Phạm Đỗ Duy",
      "Trương Trọng Lợi"
    ]
  },
  "ConnectionStrings": {
    "Lunch": ""
  },
  "Places": {
    "Provider": "Overture",
    "OvertureRelease": "",
    "GoogleApiKey": "",
    "OverpassUrl": "https://overpass-api.de/api/interpreter",
    "CacheDays": 7
  },
  "Dishes": {
    "SearxngUrl": "http://localhost:8888",
    "ChatModel": "qwen2.5:3b"
  },
  "Search": {
    "OllamaUrl": "http://localhost:11434",
    "EmbeddingModel": "nomic-embed-text"
  }
}
