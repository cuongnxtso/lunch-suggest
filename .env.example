# Copy to ".env" (next to docker-compose.yml, ignored by git), fill in, then: docker compose up -d
# See README, "Sign-in (Google)".

# Starts the ngrok tunnel together with the site.
COMPOSE_PROFILES=ngrok
# ngrok dashboard: "Your Authtoken", and your free static domain under "Domains" (e.g. lunch-xyz.ngrok-free.app).
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Google Cloud Console > APIs & Services > Credentials > your OAuth client (type "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
